# Copy this file to .env and keep the key on the server only.
# LLM provider: gemini(기본) 또는 ollama(로컬 모델, docs/llm-providers.md). npm run start:gemini·start:ollama는 이 값을 덮어쓴다.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Ollama(LLM_PROVIDER=ollama): 서버 주소, 모델(먼저 ollama pull), 문맥 길이, 메모리에 남겨 둘 시간, 호출 시간 제한(ms).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_NUM_CTX=4096
# OLLAMA_KEEP_ALIVE=20m
# OLLAMA_TIMEOUT_MS=180000
# 시험 질문 말투 다듬기(기본 on). off면 검수한 질문 은행 원문을 그대로 묻는다(호출 없음). npm run start:gemini는 설정하지 않으면 off.
# QUESTION_POLISH=
# 1이면 외부 API(Gemini)를 쓰지 않는다(LLM_PROVIDER=gemini면 서버가 시작하지 않음).
# PRIVATE_LLM_ONLY=
# 질문마다 남기는 학습 모드 trace(docs/agent-observability.md). off면 남기지 않는다. 위치 기본 data/traces.
# TRACE_LOG=
# TRACE_DIR=
# 같은 trace를 로컬 Langfuse로도 보낸다(선택, docs/agent-observability.md 'Langfuse'). 세 값이 다 있어야 켜진다.
# localhost가 아닌 주소(Langfuse Cloud 등)는 학습자 질문이 밖으로 나가므로 LANGFUSE_ALLOW_REMOTE=1이 있어야 보낸다.
# LANGFUSE_HOST=http://localhost:3100
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Login token signing key. Use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# If empty, the server makes a temporary key and every login expires on restart.
JWT_SECRET=
# Demo accounts (trainee01-20 trainees, admin01 admin) are created on startup and listed on the login screen.
# Set DEMO_ACCOUNTS=off to disable both. DEMO_PASSWORD changes the shared password for newly created demo accounts.
DEMO_ACCOUNTS=
DEMO_PASSWORD=

# [임시] 원격 팀원 테스트용 접속 비밀번호. 비워 두면 검사하지 않는다(로컬 개발). npm run tunnel은 이 값이 있어야 열린다.
TEST_PASSCODE=
# 사용자별 하루 LLM 호출 한도(기본 150, 0이면 제한 없음).
LLM_DAILY_LIMIT=150
# 체크포인트 DB 파일(기본 data/st-rookie.sqlite).
# DB_PATH=
